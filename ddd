local Players = game:GetService("Players")
local Run = game:GetService("RunService")
local Input = game:GetService("UserInputService")
local Player = Players.LocalPlayer
local PG = Player:WaitForChild("PlayerGui")

local Config = {
    Height = 20,
    Radius = 200,
    SwordRadius = 60,
    Interval = 0.25,
    Teleport = false,
    Sword = false
}

local Target
local Connections = {}
local NextSearch = 0
local NextAttack = 0

local Old = PG:FindFirstChild("NeuralV3")
if Old then Old:Destroy() end

local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Connections, c)
end

local function Root()
    return Player.Character
        and Player.Character:FindFirstChild("HumanoidRootPart")
end

local function TargetPart(model)
    return model and (
        model:FindFirstChild("HumanoidRootPart")
        or model.PrimaryPart
    )
end

local function Valid(model)
    if not model or not model:IsDescendantOf(workspace) then
        return false
    end

    local h = model:FindFirstChildOfClass("Humanoid")
    local p = TargetPart(model)

    return h and h.Health > 0
        and p and p:IsA("BasePart")
        and not Players:GetPlayerFromCharacter(model)
end

local function Nearest(radius)
    local root = Root()
    if not root then return nil end

    local best
    local distance = radius

    for _, model in ipairs(workspace:GetDescendants()) do
        if model:IsA("Model") and Valid(model) then
            local d = (TargetPart(model).Position - root.Position).Magnitude

            if d < distance then
                distance = d
                best = model
            end
        end
    end

    return best
end

