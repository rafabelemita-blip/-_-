-- LOOP PRINCIPAL OTIMIZADO

local NextScan = 0
local NextInput = 0
local NextStats = 0

task.spawn(function()
    while Running do
        local now = os.clock()
        local root = Root()

        if now >= NextScan then
            NextScan = now + 1.5
            Scan()
            Render()
        end

        local active = false

        if root then
            if Config.Portal
                and PortalTarget
                and PortalTarget:IsDescendantOf(workspace) then

                root.CFrame = CFrame.new(
                    PortalTarget.Position
                    + Vector3.new(0,3,0)
                )

                root.AssemblyLinearVelocity =
                    Vector3.zero

                Status.Text = "PORTAL | NEXT FLOOR"

                active = true

            elseif Valid(Target)
                and Priority(Target) < math.huge then

                local p = Part(Target.Object)

                root.CFrame = CFrame.new(
                    p.Position
                    + Vector3.new(
                        0,Height(Target.Kind),0
                    )
                ) * root.CFrame.Rotation

                root.AssemblyLinearVelocity =
                    Vector3.zero

                Status.Text =
                    Target.Kind.." | "..Target.Name

                active = true
            else
                Target = nil
                Status.Text = "PROCURANDO ALVO..."
            end
        end

        if now >= NextInput then
            NextInput = now + Config.Interval

            if Config.FreeF
                or (Config.AutoF and active) then

                PressF()
            end

            if Config.Click and active then
                AutoClick()
            end
        end

        if now >= NextStats then
            NextStats = now + 1

            Performance.Text =
                "FPS: "..math.floor(FPS)

            Counter.Text = "F: "..FCount

            if Config.AutoF or Config.FreeF then
                Status.Text = Status.Text
                    .." | "..InputStatus
            end
        end

        task.wait(0.08)
    end
end)

