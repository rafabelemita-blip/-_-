-- If streaming removed the selected NPC, return to its last observed area only once
-- per missing episode. Never invent coordinates or repeatedly teleport to stale data.
local function LastKnown(root,now)
    if not Config.SelectedOnly then return nil end
    local best,bestKey,bestDistance=nil,nil,math.huge
    for key,old in pairs(Remembered) do
        if Selected[key] and old.Kind~="GEMA" and not ReturnTried[key] and now-old.Seen<=300 then
            local distance=(old.Position-root.Position).Magnitude
            if distance>math.max(Config.Height+20,80) and distance<bestDistance then
                best,bestKey,bestDistance=old,key,distance
            end
        end
    end
    if bestKey then ReturnTried[bestKey]=true end
    return best
end
