-- ANIMACAO DE ABERTURA

local Visible = true
local AnimationID = 0
local CurrentTween

local function Animate(open)
    AnimationID += 1
    local id = AnimationID

    if CurrentTween then
        CurrentTween:Cancel()
    end

    if open then Main.Visible = true end

    CurrentTween = Tween:Create(
        Scale,
        TweenInfo.new(
            0.3,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {Scale = open and Fit() or Fit()*0.8}
    )

    CurrentTween:Play()

    if not open then
        task.delay(0.3,function()
            if Running and id == AnimationID then
                Main.Visible = false
            end
        end)
    end
end

Connect(Input.InputBegan,function(key,processed)
    if processed or Input:GetFocusedTextBox() then
        return
    end

    if key.KeyCode == Enum.KeyCode.G then
        Visible = not Visible
        Animate(Visible)
    end

    IdleTime = 0
end)

