local function Root(player)
    return player.Character
        and player.Character:FindFirstChild(
            "HumanoidRootPart"
        )
end

local function PetPower(key)
    local tier = tonumber(
        tostring(key):match("|(%d+)$")
    ) or 0

    return tier * 10
end

local function EquipBest(s)
    s.Weapon = s.Unlocked

    local best = ""
    local power = -1

    for key,count in pairs(s.Inventory) do
        if count > 0 and PetPower(key) > power then
            best = key
            power = PetPower(key)
        end
    end

    s.Pet = best
end

-- FUSAO DE ANIMAIS

local function Fuse(s, advanced)
    for key,count in pairs(s.Inventory) do
        local name,tier = key:match("^(.-)|(%d+)$")
        tier = tonumber(tier)

        if name and tier and count >= 3
            and not s.Favorites[name]
            and tier < 10
            and (
                (advanced and tier >= 3)
                or (not advanced and tier < 3)
            ) then

            s.Inventory[key] = count - 3

            local upgraded = name.."|"..(tier+1)

            s.Inventory[upgraded] =
                (s.Inventory[upgraded] or 0) + 1

            s.Fusions += 1

            if s.Equip then
                EquipBest(s)
            elseif s.Pet == key
                and s.Inventory[key] == 0 then
                s.Pet = ""
            end

            return true
        end
    end

    return false
end

local function Nearest(player,s)
    local root = Root(player)
    if not root then return end

    local best
    local priority = math.huge
    local nearest = s.Radius

    for _,obj in ipairs(World:GetChildren()) do
        local kind = obj:GetAttribute("Kind")
        local p = math.huge

        if kind == "BOSS" and s.Boss then
            p = 1
        elseif kind == "PORTAL"
            and s.Portal and BossDead then
            p = 2
        elseif kind == "ALFA" and s.Alpha then
            p = 3
        elseif kind == "NPC" and s.NPC then
            p = 4
        elseif kind == "GEMA" and s.Gems then
            p = 5
        end

        if s.SelectedOnly
            and kind ~= "PORTAL"
            and kind ~= "GEMA"
            and not s.Selected[obj.Name] then

            p = math.huge
        end

        local distance =
            (obj.Position-root.Position).Magnitude

        if p < math.huge and distance <= s.Radius
            and (
                p < priority
                or (p == priority and distance < nearest)
            ) then

            best = obj
            priority = p
            nearest = distance
        end
    end

    return best
end

-- COMBATE E KILL AURA

local function Damage(player,s,obj)
    if obj.Parent ~= World then return end

    local kind = obj:GetAttribute("Kind")

    if kind ~= "NPC" and kind ~= "ALFA"
        and kind ~= "BOSS" then
        return
    end

    local root = Root(player)
    if not root then return end

    if (obj.Position-root.Position).Magnitude
        > s.AttackRadius then
        return
    end

    local damage = Weapons[s.Weapon].Damage
        + PetPower(s.Pet)

    local hp = math.max(
        0, obj:GetAttribute("HP")-damage
    )

    obj:SetAttribute("HP",hp)

    local label = obj:FindFirstChildWhichIsA(
        "TextLabel",true
    )

    if label then
        label.Text = obj.Name.." | HP: "..hp
    end

    if hp <= 0 then
        local name = obj.Name
        local position = obj.Position
        local maximum = obj:GetAttribute("MaxHP")
        local oldFloor = Floor

        s.Kills += 1
        s.PendingRewards += 1
        s.GemCount += kind == "BOSS" and 50 or 2

        s.Unlocked = math.min(
            #Weapons, 1+math.floor(s.Kills/3)
        )

        if s.Tame then
            local key = name.."|1"

            s.Inventory[key] =
                (s.Inventory[key] or 0)+1
        end

        obj:Destroy()

        if kind == "BOSS" then
            BossDead = true

            CreateEntity(
                "NEXT FLOOR","PORTAL",1,
                Origin+Vector3.new(125,5,60)
            )
        else
            task.delay(6,function()
                if Floor == oldFloor then
                    CreateEntity(
                        name,kind,maximum,position
                    )
                end
            end)
        end

        if s.Equip then
            EquipBest(s)
        end
    end
end

local function Attack(player,s,target)
    if os.clock() < s.NextAttack then return end

    s.NextAttack = os.clock()+s.Interval

    if s.Aura or s.All then
        for _,obj in ipairs(World:GetChildren()) do
            Damage(player,s,obj)
        end

    elseif target then
        Damage(player,s,target)
    end
end

local function Interact(player,s,target)
    if not target or target.Parent ~= World then
        return
    end

    local root = Root(player)
    if not root then return end

    local kind = target:GetAttribute("Kind")
    local distance =
        (target.Position-root.Position).Magnitude

    if kind == "GEMA" and distance <= 8 then
        s.GemCount += 10
        target:Destroy()

    elseif kind == "PORTAL"
        and BossDead and distance <= 8 then

        Floor += 1
        GenerateFloor()

    else
        Attack(player,s,target)
    end
end

-- COMANDOS VALIDADOS

local Toggles = {
    Aura=true, All=true, NPC=true,
    Boss=true, Alpha=true, AutoF=true,
    Click=true, Gems=true, Portal=true,
    Equip=true, Fusion=true, AuraFusion=true,
    Tame=true, Rewards=true, SelectedOnly=true
}

Remote.OnServerEvent:Connect(function(player,action,key,value)
    local s = States[player]
    if not s then return end

    if action == "Toggle" and Toggles[key] then
        s[key] = not s[key]

        if key == "Equip" and s.Equip then
            EquipBest(s)
        end

    elseif action == "Setting"
        and type(value) == "number"
        and value == value
        and math.abs(value) < math.huge then

        if key == "Radius" then
            s.Radius = math.clamp(value,50,2000)

        elseif key == "AttackRadius" then
            s.AttackRadius = math.clamp(value,5,100)

        elseif key == "Interval" then
            s.Interval = math.clamp(value,0.15,2)
        end

    elseif action == "Select"
        and type(key) == "string"
        and #key <= 100 then

        s.Selected[key] = not s.Selected[key]

    elseif action == "Favorite"
        and type(key) == "string"
        and #key <= 100 then

        s.Favorites[key] = not s.Favorites[key]

    elseif action == "EquipNow" then
        EquipBest(s)

    elseif action == "ManualF" then
        local target = Nearest(player,s)

        if target then
            Interact(player,s,target)
        else
            Attack(player,s)
        end

    elseif action == "Stop" then
        for name in pairs(Toggles) do
            s[name] = false
        end

        s.Status = "STOPPED"
    end
end)

-- RADAR SEM NOMES DUPLICADOS

local function Snapshot(player,s)
    local groups = {}
    local root = Root(player)

    if root then
        for _,obj in ipairs(World:GetChildren()) do
            local distance =
                (obj.Position-root.Position).Magnitude

            if distance <= s.Radius then
                local g = groups[obj.Name]

                if not g then
                    groups[obj.Name] = {
                        Name = obj.Name,
                        Kind = obj:GetAttribute("Kind"),
                        Count = 1,
                        Distance = math.floor(distance)
                    }
                else
                    g.Count += 1

                    g.Distance = math.min(
                        g.Distance,
                        math.floor(distance)
                    )
                end
            end
        end
    end

    local list = {}

    for _,g in pairs(groups) do
        table.insert(list,g)
    end

    table.sort(list,function(a,b)
        return a.Distance < b.Distance
    end)

    local data = table.clone(s)
    data.Groups = list
    data.Floor = Floor
    data.WeaponName = Weapons[s.Weapon].Name
    data.Damage = Weapons[s.Weapon].Damage
        + PetPower(s.Pet)

    Remote:FireClient(player,data)
end

-- AUTOMACAO PRINCIPAL

task.spawn(function()
    while true do
        local now = os.clock()

        for player,s in pairs(States) do
            local root = Root(player)

            if root then
                local target = Nearest(player,s)

                if target then
                    local kind = target:GetAttribute("Kind")

                    local height =
                        kind == "BOSS" and 50
                        or kind == "ALFA" and 30
                        or kind == "NPC" and 20
                        or 3

                    root.CFrame = CFrame.new(
                        target.Position
                        + Vector3.new(0,height,0)
                    )

                    root.AssemblyLinearVelocity =
                        Vector3.zero

                    s.Status = target.Name

                    if s.AutoF or kind == "GEMA"
                        or kind == "PORTAL" then

                        Interact(player,s,target)

                    else
                        Attack(player,s,target)
                    end
                end

                if s.Aura or s.All or s.Click then
                    Attack(player,s,target)
                end

                if now >= s.NextFusion then
                    s.NextFusion = now+1

                    if s.Fusion then
                        Fuse(s,false)
                    end

                    if s.AuraFusion then
                        Fuse(s,true)
                    end
                end

                if s.Rewards and s.PendingRewards > 0 then
                    s.RewardsCount += s.PendingRewards
                    s.GemCount += s.PendingRewards*5
                    s.PendingRewards = 0
                end

                if s.Equip then
                    EquipBest(s)
                end

                if now >= s.NextUpdate then
                    s.NextUpdate = now+0.8
                    Snapshot(player,s)
                end
            end
        end

        task.wait(0.15)
    end
end)

