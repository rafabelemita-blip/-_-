    row.Distance=Text(frame,"",320,0,70,34,12)
    row.Type=Button(frame,"",400,2,75,30)
    Connect(row.Name.Activated,function()
        if row.Entry then
            local key=row.Entry.Key
            Selected[key]=not Selected[key]
            Target=nil; NearbyEnemy=false
            Render()
        end
    end)
    Connect(row.Type.Activated,function()
        if not row.Entry or row.Entry.Kind=="GEMA" then return end
        local cycle={NPC="ALFA",ALFA="BOSS",BOSS="NPC"}
        Overrides[row.Entry.Key]=cycle[row.Entry.Kind] or "NPC"
        Scan(); Render()
    end)
    Rows[i]=row
    return row
end
Render=function()
    if not Visible then return end
    local index=0
    for _,g in ipairs(Groups) do
        if Has(g.Name,Search.Text:lower()) then
            index=index+1
            if index>100 then break end
            local row=Rows[index] or CreateRow(index)
            row.Entry=g; row.Frame.Visible=true
            row.Name.Text=(Selected[g.Key] and "[X] " or "[ ] ")..g.Name
            row.Name.BackgroundColor3=Selected[g.Key] and Colors.Blue or Colors.BG
            row.Count.Text=tostring(g.Count)
            row.Distance.Text=math.floor(g.Distance).." ST"
            row.Type.Text=g.Kind
            row.Type.TextColor3=g.Kind=="BOSS" and Colors.Red or g.Kind=="GEMA" and Colors.Green or Colors.Blue
        end
    end
    for i=index+1,#Rows do Rows[i].Frame.Visible=false; Rows[i].Entry=nil end
end
