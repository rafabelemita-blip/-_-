local DynamicRows = {}

local function Dynamic(index,text,action,key)
    local b = DynamicRows[index]

    if not b then
        b = Row(text)
        DynamicRows[index] = b
        b:SetAttribute("Action",action or "")
        b:SetAttribute("Key",key or "")

        b.Activated:Connect(function()
            local a = b:GetAttribute("Action")
            local k = b:GetAttribute("Key")

            if a ~= "" then
                Remote:FireServer(a,k)
            end
        end)
    end

    b.Visible = true
    b.Text = text
    b:SetAttribute("Action",action or "")
    b:SetAttribute("Key",key or "")
