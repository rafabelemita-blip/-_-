    local index = 0

    if Page == "Radar" or Page == "Dashboard"
        or Page == "Bosses" or Page == "Animais" then

        for _,g in ipairs(Data.Groups or {}) do
            local show =
                Page == "Radar"
                or Page == "Dashboard"
                or (Page == "Bosses" and g.Kind == "BOSS")
                or (
                    Page == "Animais"
                    and (g.Kind == "NPC" or g.Kind == "ALFA")
                )

            if show then
                index += 1

                local selected = Data.Selected
                    and Data.Selected[g.Name]

                Dynamic(index,
                    (selected and "[X] " or "[ ] ")
