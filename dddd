-- AUTO EQUIP: apenas Tools com dano numerico verificavel.
local function WeaponScore(tool)
    if not tool:IsA("Tool") then return nil end
    for _,key in ipairs({"Damage","AttackDamage","BaseDamage"}) do
        local value=tool:GetAttribute(key)
        if type(value)=="number" and value==value and value>0 and value<math.huge then return value end
        local child=tool:FindFirstChild(key)
        if child and (child:IsA("NumberValue") or child:IsA("IntValue")) and child.Value>0 and child.Value<math.huge then return child.Value end
    end
end
local function EquipBest()
    local char=Player.Character
    local humanoid=char and char:FindFirstChildOfClass("Humanoid")
    local backpack=Player:FindFirstChildOfClass("Backpack")
    if not humanoid or not backpack then return end
    local current=char:FindFirstChildOfClass("Tool")
    local best,bestScore=current,current and WeaponScore(current)
    if current and not bestScore then EquipInfo.Text="Arma atual sem dano verificavel"; return end
    for _,tool in ipairs(backpack:GetChildren()) do
        local score=WeaponScore(tool)
        if score and (not bestScore or score>bestScore) then best,bestScore=tool,score end
    end
    if best and bestScore then
        if best~=current then humanoid:EquipTool(best) end
        EquipInfo.Text="Arma: "..best.Name.." | Dano: "..bestScore
    else EquipInfo.Text="Nenhuma arma com dano visivel" end
end
