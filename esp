-- Script educacional: Botão de voo com toggle
-- Compatível com executores (Solara V3, Krnl, etc.)

-- Carrega a biblioteca de interface (padrão em executores)
local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/..." ))()

-- Cria a janela principal
local Window = Library:CreateWindow("Meu Script")
local Tab = Window:CreateTab("Voo")

-- Variáveis de controle
local flying = false
local speed = 50 -- Velocidade do voo
local bodyVelocity = nil
local bodyGyro = nil

-- Função para iniciar o voo
local function startFlying()
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    -- Configura o humanoid para não cair
    humanoid.PlatformStand = true
    
    -- Cria o BodyVelocity para mover o personagem
    bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * 10000
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = rootPart
    
    -- Cria o BodyGyro para controlar a rotação
    bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * 10000
    bodyGyro.DFrame = 1000
    bodyGyro.Parent = rootPart
    
    flying = true
end

-- Função para parar o voo
local function stopFlying()
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    
    local humanoid = character:WaitForChild("Humanoid")
    local rootPart = character:WaitForChild("HumanoidRootPart")
    
    -- Remove os objetos de voo
    if bodyVelocity then
        bodyVelocity:Destroy()
        bodyVelocity = nil
    end
    
    if bodyGyro then
        bodyGyro:Destroy()
        bodyGyro = nil
    end
    
    -- Restaura o humanoid
    humanoid.PlatformStand = false
    
    flying = false
end

-- Cria o botão na interface
Tab:CreateButton("Ativar/Desativar Voo", function()
    if flying then
        stopFlying()
    else
        startFlying()
    end
end)

-- Loop para controlar o movimento durante o voo
game:GetService("RunService").Heartbeat:Connect(function()
    if not flying then return end
    
    local player = game.Players.LocalPlayer
    local character = player.Character
    if not character then return end
    
    local rootPart = character:WaitForChild("HumanoidRootPart")
    local camera = workspace.CurrentCamera
    
    -- Pega a direção da câmera
    local cameraDirection = camera.CFrame.LookVector
    
    -- Controles: WASD para mover, Space para subir, Shift para descer
    local moveDirection = Vector3.new()
    
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
        moveDirection = moveDirection + cameraDirection
    end
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
        moveDirection = moveDirection - cameraDirection
    end
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
        moveDirection = moveDirection - cameraDirection:Cross(Vector3.new(0, 1, 0))
    end
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
        moveDirection = moveDirection + cameraDirection:Cross(Vector3.new(0, 1, 0))
    end
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
        moveDirection = moveDirection + Vector3.new(0, 1, 0)
    end
    if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftShift) then
        moveDirection = moveDirection - Vector3.new(0, 1, 0)
    end
    
    -- Normaliza a direção e aplica velocidade
    if moveDirection.Magnitude > 0 then
        moveDirection = moveDirection.Unit * speed
    end
    
    -- Aplica o movimento
    bodyVelocity.Velocity = moveDirection
    bodyGyro.CFrame = camera.CFrame
end)
