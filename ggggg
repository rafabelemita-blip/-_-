local function Root()
    return Player.Character
        and Player.Character:FindFirstChild(
            "HumanoidRootPart"
        )
end

local function Part(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart")
    end
end

local function Has(text,word)
    return string.find(
        tostring(text):lower(),word,1,true
    ) ~= nil
end

local function Key(name)
    return name:lower():gsub("^%s+","")
        :gsub("%s+$",""):gsub("%s+"," ")
end

local function NameOf(obj)
    local name = obj:GetAttribute("DisplayName")
        or obj:GetAttribute("MobName")
        or obj.Name

    return tostring(name)
end

local function Classify(obj)
    if not obj:IsDescendantOf(workspace) then
        return nil
    end

    local name = NameOf(obj)

    if obj:IsA("Model") then
        if Players:GetPlayerFromCharacter(obj) then
            return nil
        end

        local h = obj:FindFirstChildOfClass("Humanoid")

        if h and h.Health <= 0 then
            return nil
        end

        local category = tostring(
            obj:GetAttribute("Type")
            or obj:GetAttribute("Category")
            or obj:GetAttribute("Rank")
            or ""
        )

        local boss =
            obj:GetAttribute("IsBoss") == true
            or obj:GetAttribute("Boss") == true
            or Tags:HasTag(obj,"Boss")
            or Tags:HasTag(obj,"WorldBoss")
            or Has(name,"boss")
            or Has(category,"boss")

        local alpha =
            Tags:HasTag(obj,"Alpha")
            or Has(name,"alpha")
            or Has(name,"alfa")
            or Has(category,"alpha")

        local creature =
            h
            or boss
            or alpha
            or Tags:HasTag(obj,"Animal")
            or Tags:HasTag(obj,"NPC")
            or Tags:HasTag(obj,"Mob")

        if creature then
            local override = Overrides[Key(name)]
            if override then return override end

            if boss then return "BOSS" end
            if alpha then return "ALFA" end
            return "NPC"
        end
    end

    if Tags:HasTag(obj,"Gem")
        or Has(name,"gem")
        or Has(name,"crystal") then
        return "GEMA"
    end
end

-- CACHE DE ENTIDADES

local function Index(obj)
    if obj:IsA("Model") then
        Cache[obj] = true

    elseif obj:IsA("BasePart") then
        if Tags:HasTag(obj,"Gem")
            or Has(obj.Name,"gem")
            or Has(obj.Name,"crystal") then

            Cache[obj] = true
        end
    end
end

Connect(workspace.DescendantAdded,Index)

Connect(workspace.DescendantRemoving,function(obj)
    Cache[obj] = nil
end)

task.spawn(function()
    local objects = workspace:GetDescendants()

