-- ABERTURA ANIMADA

local Animation
local AnimationID = 0

local function Animate(open)
    AnimationID += 1
    local id = AnimationID

    if Animation then
        Animation:Cancel()
    end

    if open then Main.Visible = true end

    local camera = workspace.CurrentCamera

    local fit = camera and math.min(
        1,
        camera.ViewportSize.X/840,
        camera.ViewportSize.Y/580
    ) or 1

    Animation = Tween:Create(
        Scale,
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {Scale = open and fit or fit*0.8}
    )

    Animation:Play()

    if not open then
        task.delay(0.25,function()
            if Running and id == AnimationID then
                Main.Visible = false
            end
        end)
    else
        Render()
    end
end

Connect(Input.InputBegan,function(key,processed)
    if processed or Input:GetFocusedTextBox() then
        return
    end

    if key.KeyCode == Enum.KeyCode.G then
        Visible = not Visible
        Animate(Visible)
    end
end)

