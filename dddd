end
local function Part(obj)
    if not obj then return end
    if obj:IsA("BasePart") then return obj end
    if obj:IsA("Model") then
        local p=obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart",true)
        if p and p:IsA("BasePart") then return p end
    end
end
local function Name(obj)
    return tostring(obj:GetAttribute("DisplayName") or obj:GetAttribute("MobName") or obj.Name)
end
local function Key(name)
    return name:lower():gsub("^%s+",""):gsub("%s+$",""):gsub("%s+"," ")
end
local function Has(text,word)
    return string.find(tostring(text):lower(),word,1,true)~=nil
end
local function IsPortal(text)
    text=tostring(text):lower():gsub("[%s_%-]","")
    return text=="nextfloor" or text=="nexusfloor"
end
local function Classify(obj)
    local name=Name(obj)
    if obj:IsA("Model") then
        if Players:GetPlayerFromCharacter(obj) then return end
        local h=obj:FindFirstChildOfClass("Humanoid")
        if h and h.Health<=0 then return end
        local category=tostring(obj:GetAttribute("Type") or "").." "..tostring(obj:GetAttribute("Category") or "").." "..tostring(obj:GetAttribute("Rank") or "")
        local boss=Tags:HasTag(obj,"Boss") or Tags:HasTag(obj,"WorldBoss")
            or obj:GetAttribute("IsBoss")==true or obj:GetAttribute("Boss")==true
            or obj:GetAttribute("IsWorldBoss")==true or Has(name,"boss") or Has(category,"boss")
        local alpha=Has(name,"alpha") or Has(name,"alfa") or Tags:HasTag(obj,"Alpha") or Has(category,"alpha")
        if h or boss or alpha or Tags:HasTag(obj,"Animal") or Tags:HasTag(obj,"NPC") then
            if Overrides[Key(name)] then return Overrides[Key(name)] end
            if boss then return "BOSS" end
            if alpha then return "ALFA" end
            return "NPC"
        end
    end
    if Tags:HasTag(obj,"Gem") or Has(name,"gem") or Has(name,"crystal") then return "GEMA" end
end
-- CACHE: uma varredura inicial e eventos de entrada/saida.
local function Index(obj)
    if obj:IsA("Model") or obj:IsA("TextLabel") or (obj:IsA("BasePart") and
        (IsPortal(obj.Name) or Tags:HasTag(obj,"Gem") or Has(obj.Name,"gem") or Has(obj.Name,"crystal"))) then
        Cache[obj]=true
    end
end
