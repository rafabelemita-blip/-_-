-- ANIMACAO DO PAINEL

local Visible = true
local AnimationID = 0
local CurrentTween

local function Animate(open)
    AnimationID += 1
    local id = AnimationID

    if CurrentTween then
        CurrentTween:Cancel()
    end

    if open then
        Frame.Visible = true
    end

    CurrentTween = Tween:Create(
        Scale,
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {Scale = open and 1 or 0.75}
    )

    CurrentTween:Play()

    if not open then
        task.delay(0.25,function()
            if id == AnimationID and Running then
                Frame.Visible = false
            end
        end)
    end
end

Connect(Input.InputBegan,function(key,processed)
    if processed or Input:GetFocusedTextBox() then
        return
    end

    if key.KeyCode == Enum.KeyCode.G then
        Visible = not Visible
        Animate(Visible)
    end
end)

Animate(true)

-- SCANNER DE ENTIDADES

local function Scan()
    local root = Root()
    if not root then
        Results = {}
        return
    end

    local found = {}

    for _,object in ipairs(workspace:GetDescendants()) do
        if object:IsA("Model") or object:IsA("BasePart") then
            local kind = Classify(object)

            if kind then
                local part = Part(object)

                if part and part:IsA("BasePart") then
                    local distance =
                        (part.Position-root.Position).Magnitude

                    if distance <= Config.Radius then
                        table.insert(found,{
                            Object = object,
                            Name = object.Name,
                            Kind = kind,
                            Distance = distance,
                            Island = FindIsland(object)
                        })
                    end
                end
            end
        end
    end

    table.sort(found,function(a,b)
        return a.Distance < b.Distance
    end)

    Results = found
end

local function RefreshRadar()
    for _,object in ipairs(List:GetChildren()) do
        if object:IsA("Frame") then
            object:Destroy()
        end
    end

    for i,entry in ipairs(Results) do
        local item = New("Frame",List,{
            Size = UDim2.new(1,-5,0,48),
            BackgroundColor3 = Black,
            LayoutOrder = i
        })

        Corner(item,5)

        Text(item,
            entry.Kind.." | "..entry.Name,
            8,2,220,23,12,Red)

        Text(item,
            entry.Island,
            8,25,220,18,10,White)

        local d = Text(item,
            math.floor(entry.Distance).." ST",
            230,5,75,30,12,White)

        d.TextXAlignment = Enum.TextXAlignment.Right
    end
end

-- PRIORIDADE AUTOMATICA

local function Priority(entry)
    if entry.Kind == "BOSS" and Config.Boss then
        return 1
    elseif entry.Kind == "ALFA" and Config.NPC then
        return 2
    elseif entry.Kind == "NPC" and Config.NPC then
        return 3
    elseif entry.Kind == "GEMA" and Config.Gems then
        return 4
    end

    return math.huge
end

local function SelectTarget()
    local best
    local bestPriority = math.huge

    for _,entry in ipairs(Results) do
        if IsValid(entry) then
            local p = Priority(entry)

            if p < bestPriority then
                best = entry
                bestPriority = p
            end
        end
    end

    if IsValid(Target)
        and Priority(Target) < math.huge
        and Priority(Target) <= bestPriority then

        local root = Root()
        local part = Part(Target.Object)

        if root and part
            and (part.Position-root.Position).Magnitude
                <= Config.Radius then

            return Target
        end
    end

    return best
end

-- ATUALIZACAO

local NextScan = 0
local NextAttack = 0

Connect(Run.Heartbeat,function()
    if not Running then return end

    local root = Root()
    if not root then return end

    local now = os.clock()

    if now >= NextScan then
        NextScan = now + 1

        Scan()
        RefreshRadar()
        Target = SelectTarget()
    end

    if not IsValid(Target) then
        Target = SelectTarget()
    end

    if Target and IsValid(Target) then
        local part = Part(Target.Object)
        local height = Config.NPCH

        if Target.Kind == "BOSS" then
            height = Config.BossH
        elseif Target.Kind == "ALFA" then
            height = Config.AlphaH
        elseif Target.Kind == "GEMA" then
            height = 3
        end

        root.CFrame = CFrame.new(
            part.Position + Vector3.new(0,height,0)
        ) * root.CFrame.Rotation

        root.AssemblyLinearVelocity = Vector3.zero

        Status.Text = Target.Kind
            .." | "..Target.Name
            .." | ALT: "..height
            .." | RADAR: "..#Results

        Island.Text = "ILHA: "..Target.Island
    else
        Status.Text = "SCANNING | ENTIDADES: "..#Results
        Island.Text = "ILHA: "..FindIsland(root)
    end

    if Config.Sword and now >= NextAttack then
        NextAttack = now + Config.AttackInterval

        local character = Player.Character
        local tool = character
            and character:FindFirstChildOfClass("Tool")

        if tool and Target
            and Target.Kind ~= "GEMA"
            and IsValid(Target) then

            tool:Activate()
        end
    end
end)

