local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Connections,c)
    return c
end

local function New(class,parent,properties)
    local object = Instance.new(class)

    for key,value in pairs(properties or {}) do
        object[key] = value
    end

    object.Parent = parent
    return object
end

local function Corner(object,radius)
    New("UICorner",object,{
        CornerRadius = UDim.new(0,radius)
    })
end

local function Root()
    local c = Player.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function Part(object)
    if not object then return nil end

    if object:IsA("BasePart") then
        return object
    end

    if object:IsA("Model") then
        return object:FindFirstChild("HumanoidRootPart")
            or object.PrimaryPart
            or object:FindFirstChildWhichIsA("BasePart",true)
    end
end

local function Contains(text,word)
    return string.find(text,word,1,true) ~= nil
end

local function IsValid(entry)
    if not entry or not entry.Object then
        return false
    end

    if not entry.Object:IsDescendantOf(workspace) then
        return false
    end

    local h = entry.Object:FindFirstChildOfClass("Humanoid")

    if h and h.Health <= 0 then
        return false
    end

    return Part(entry.Object) ~= nil
end

local function Classify(object)
    local name = object.Name:lower()

    if object:IsA("Model") then
        if Players:GetPlayerFromCharacter(object) then
            return nil
        end

        local humanoid = object:FindFirstChildOfClass("Humanoid")

        local mob = humanoid
            or Tags:HasTag(object,"Animal")
            or Tags:HasTag(object,"NPC")
            or Tags:HasTag(object,"Mob")
            or Tags:HasTag(object,"Boss")

        if mob then
            if humanoid and humanoid.Health <= 0 then
                return nil
            end

            if Contains(name,"boss")
                or Tags:HasTag(object,"Boss")
                or object:GetAttribute("IsBoss") == true then

                return "BOSS"
            end

            if Contains(name,"alpha")
                or Contains(name,"alfa")
                or Tags:HasTag(object,"Alpha") then

                return "ALFA"
            end

            return "NPC"
        end
    end

    if object:IsA("BasePart") or object:IsA("Model") then
        if Tags:HasTag(object,"Gem")
            or Contains(name,"gem")
            or Contains(name,"gema")
            or Contains(name,"crystal") then

            return "GEMA"
        end
    end

    return nil
end

local function FindIsland(object)
    local current = object

    while current and current ~= workspace do
        local name = current.Name:lower()

        if Contains(name,"island")
            or Contains(name,"ilha")
            or Tags:HasTag(current,"Island") then

            return current.Name
        end

        current = current.Parent
    end

    return "Ilha nao identificada"
end

