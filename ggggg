-- AGRUPAMENTO SEM DUPLICACAO

local function Height(kind)
    if kind == "BOSS" then return Config.BossH end
    if kind == "ALFA" then return Config.AlphaH end
    if kind == "GEMA" then return 3 end
    return Config.NPCH
end

local function Priority(entry)
    if Config.SelectedOnly
        and not Selected[entry.Key] then
        return math.huge
    end

    if entry.Kind == "BOSS" and Config.Boss then
        return 1
    end

    if entry.Kind == "ALFA" and Config.NPC then
        return 2
    end

    if entry.Kind == "NPC" and Config.NPC then
        return 3
    end

    if entry.Kind == "GEMA" and Config.Gems then
        return 4
    end

    return math.huge
end

local function Valid(entry)
    if not entry or not entry.Object then
        return false
    end

    if not entry.Object:IsDescendantOf(workspace) then
        return false
    end

    local h = entry.Object:FindFirstChildOfClass("Humanoid")

    return Part(entry.Object) ~= nil
        and (not h or h.Health > 0)
end

local function Scan()
    local root = Root()
    if not root then return end

    local grouped = {}
    local best
    local bestPriority = math.huge

    Total = 0
    BossTotal = 0

    for obj in pairs(Cache) do
        if not obj:IsDescendantOf(workspace) then
            Cache[obj] = nil
        else
            local kind = Classify(obj)

            if kind then
                local part = Part(obj)

                if part and part:IsA("BasePart") then
                    local distance = (
                        part.Position-root.Position
                    ).Magnitude

                    if distance <= Config.Radius then
                        local name = NameOf(obj)
                        local key = Key(name)

                        local entry = {
                            Object = obj,
                            Key = key,
                            Name = name,
                            Kind = kind,
                            Distance = distance
                        }

                        Total += 1

                        if kind == "BOSS" then
                            BossTotal += 1
                        end

                        local g = grouped[key]

                        if not g then
                            grouped[key] = {
                                Key = key,
                                Name = name,
                                Kind = kind,
                                Count = 1,
                                Distance = distance
                            }
                        else
                            g.Count += 1

                            if distance < g.Distance then
                                g.Distance = distance
                                g.Kind = kind
                            end
                        end

                        local priority = Priority(entry)

                        if priority < math.huge then
                            if not best
                                or priority < bestPriority
                                or (
                                    priority == bestPriority
                                    and distance < best.Distance
                                ) then

                                best = entry
                                bestPriority = priority
                            end
                        end
                    end
                end
            end
        end
    end

    Groups = {}

    for _,g in pairs(grouped) do
        table.insert(Groups,g)
    end

    table.sort(Groups,function(a,b)
        return a.Distance < b.Distance
    end)

    Target = best

    EntityCount.Text = tostring(Total)
    SpeciesCount.Text = tostring(#Groups)
end

-- REUTILIZACAO DE LINHAS

local function CreateRow(index)
    local f = New("Frame",List,{
        Size = UDim2.new(1,-6,0,38),
        BackgroundColor3 = C.BG,
        LayoutOrder = index,
        BorderSizePixel = 0
    })
    Round(f,7)

    local row = {
        Frame = f,
        Entry = nil
    }

    row.Name = Button(f,"",5,2,265,34)
    row.Count = Text(f,"",280,0,60,38,12,C.White)
    row.Distance = Text(f,"",340,0,90,38,12,C.Gray)
    row.Type = Button(f,"",440,3,100,32)

    Connect(row.Name.Activated,function()
        if not row.Entry then return end

        local key = row.Entry.Key
        Selected[key] = not Selected[key]

        Target = nil
        Render()
    end)

    Connect(row.Type.Activated,function()
        if not row.Entry then return end

        local key = row.Entry.Key

        if row.Entry.Kind == "GEMA" then
            return
        end

        local cycle = {
            NPC = "ALFA",
            ALFA = "BOSS",
            BOSS = "NPC"
        }

        Overrides[key] = cycle[row.Entry.Kind]
            or "NPC"

        Scan()
        Render()
    end)

    Rows[index] = row
    return row
end

Render = function()
    if not Visible or not Radar.Visible then
        return
    end

    local query = Search.Text:lower()
    local i = 0

    for _,g in ipairs(Groups) do
        local show =
            Page == "Dashboard"
            or Page == "Radar"
            or (Page == "Bosses" and g.Kind == "BOSS")
            or (
                Page == "Animais"
                and (g.Kind == "NPC" or g.Kind == "ALFA")
            )
            or (Page == "Gemas" and g.Kind == "GEMA")

        if show and Has(g.Name,query) then
            i += 1

            if i > 100 then break end

            local row = Rows[i] or CreateRow(i)

            row.Entry = g
            row.Frame.Visible = true

            row.Name.Text = (
                Selected[g.Key] and "[X] " or "[ ] "
            ) .. g.Name

            row.Name.BackgroundColor3 =
                Selected[g.Key] and C.Purple
                or C.BG

            row.Count.Text = tostring(g.Count)

            row.Distance.Text =
                math.floor(g.Distance).." ST"

            row.Type.Text = g.Kind

            row.Type.TextColor3 =
                g.Kind == "BOSS" and C.Red
                or g.Kind == "ALFA" and C.Orange
                or g.Kind == "GEMA" and C.Green
                or C.Purple
        end
    end

    for j = i+1,#Rows do
        Rows[j].Frame.Visible = false
        Rows[j].Entry = nil
    end
end

