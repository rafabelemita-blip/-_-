-- AUTO F: API original; sem promessa de disponibilidade.
local function PressF()
    if Input:GetFocusedTextBox() then return end
    if not Virtual then InputStatus="AUTO F INDISPONIVEL"; return end
    local success=pcall(function()
        Virtual:SendKey(true,Enum.KeyCode.F,false)
        task.wait(0.04)
        Virtual:SendKey(false,Enum.KeyCode.F,false)
    end)
    if success then FCount=FCount+1; InputStatus="AUTO F ATIVO"
    else InputStatus="ENTRADA VIRTUAL BLOQUEADA" end
end
local function AutoClick()
    if Input:GetFocusedTextBox() then return end
    local char=Player.Character
    local tool=char and char:FindFirstChildOfClass("Tool")
    if tool then pcall(function() tool:Activate() end) end
end
-- AUTO EQUIP: apenas Tools com dano numerico verificavel.
local function WeaponScore(tool)
    if not tool:IsA("Tool") then return nil end
    for _,key in ipairs({"Damage","AttackDamage","BaseDamage"}) do
        local value=tool:GetAttribute(key)
        if type(value)=="number" and value==value and value>0 and value<math.huge then return value end
        local child=tool:FindFirstChild(key)
        if child and (child:IsA("NumberValue") or child:IsA("IntValue")) and child.Value>0 and child.Value<math.huge then return child.Value end
    end
end
local function EquipBest()
    local char=Player.Character
    local humanoid=char and char:FindFirstChildOfClass("Humanoid")
    local backpack=Player:FindFirstChildOfClass("Backpack")
    if not humanoid or not backpack then return end
    local current=char:FindFirstChildOfClass("Tool")
    local best,bestScore=current,current and WeaponScore(current)
    if current and not bestScore then EquipInfo.Text="Arma atual sem dano verificavel"; return end
    for _,tool in ipairs(backpack:GetChildren()) do
        local score=WeaponScore(tool)
        if score and (not bestScore or score>bestScore) then best,bestScore=tool,score end
    end
    if best and bestScore then
        if best~=current then humanoid:EquipTool(best) end
        EquipInfo.Text="Arma: "..best.Name.." | Dano: "..bestScore
    else EquipInfo.Text="Nenhuma arma com dano visivel" end
end
-- ANIMACAO
local Animation
local AnimationID=0
local function Animate(open)
    AnimationID=AnimationID+1
    local id=AnimationID
    if Animation then Animation:Cancel() end
    if open then Main.Visible=true end
    local camera=workspace.CurrentCamera
    local fit=camera and math.min(1,camera.ViewportSize.X/840,camera.ViewportSize.Y/580) or 1
    Animation=Tween:Create(Scale,TweenInfo.new(0.25,Enum.EasingStyle.Quart,Enum.EasingDirection.Out),{Scale=open and fit or fit*0.8})
    Animation:Play()
    if not open then
        task.delay(0.25,function() if Running and id==AnimationID then Main.Visible=false end end)
    else Render() end
end
Connect(Input.InputBegan,function(key,processed)
    if processed or Input:GetFocusedTextBox() then return end
    if key.KeyCode==Enum.KeyCode.G then Visible=not Visible; Animate(Visible) end
end)
Connect(Run.RenderStepped,function(dt) FPS=FPS*0.95+(1/math.max(dt,0.001))*0.05 end)
-- LOOP V7: cache a cada 1.5s, sem recriar as linhas.
local NextScan,NextInput,NextStats,NextEquip=0,0,0,0
Connect(Gui.Destroying,function()
    Running=false
    for _,c in ipairs(Connections) do c:Disconnect() end
    table.clear(Cache); table.clear(Groups)
end)
task.spawn(function()
    while Running do
        local now=os.clock()
        local root=Root()
        if now>=NextScan then NextScan=now+1.5; Scan(); Render() end
        local active=false
        local atPortal=false
        if root then
            if Config.Portal and PortalTarget and PortalTarget:IsDescendantOf(workspace) then
                root.CFrame=CFrame.new(PortalTarget.Position+Vector3.new(0,3,0))
                root.AssemblyLinearVelocity=Vector3.zero
                Status.Text="PORTAL | NEXT FLOOR"
                active=true; atPortal=true
            elseif Valid(Target) and Priority(Target)<math.huge then
                local p=Part(Target.Object)
                root.CFrame=CFrame.new(p.Position+Vector3.new(0,Height(Target.Kind),0))*root.CFrame.Rotation
                root.AssemblyLinearVelocity=Vector3.zero
                Status.Text=Target.Kind.." | "..Target.Name
                active=true
            else
                Target=nil
                Status.Text="PROCURANDO ALVO..."
            end
        end
        if now>=NextInput then
            NextInput=now+Config.Interval
            if Config.FreeF or (Config.AutoF and active) then PressF() end
            if Running and root and not atPortal and (((Config.Click or Config.All) and active and Valid(Target) and Target.Kind~="GEMA") or (Config.Aura and NearbyEnemy)) then AutoClick() end
        end
        if Running and Config.Equip and now>=NextEquip then
            NextEquip=now+1
            local success=pcall(EquipBest)
            if not success then EquipInfo.Text="Equipamento indisponivel" end
        end
        if now>=NextStats then
            NextStats=now+1
            Performance.Text="FPS: "..math.floor(FPS)
            Counter.Text="F: "..FCount
            if Config.AutoF or Config.FreeF then Status.Text=Status.Text.." | "..InputStatus end
        end
        task.wait(0.08)
    end
end)
Animate(true)
