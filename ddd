local TP = Button("AUTO TELEPORT [OFF]", 108)
local Sword = Button("AUTO SWORD [OFF]", 160)

local Status = Label("SISTEMA EM ESPERA", 215, 12,
    Color3.fromRGB(255,70,70))

Label("[ G ] ABRIR / ESCONDER", 270, 12,
    Color3.fromRGB(150,150,150))

local function Refresh()
    TP.Text = Config.Teleport
        and "AUTO TELEPORT [ON]"
        or "AUTO TELEPORT [OFF]"

    Sword.Text = Config.Sword
        and "AUTO SWORD [ON]"
        or "AUTO SWORD [OFF]"

    TP.BackgroundColor3 = Config.Teleport
        and Color3.fromRGB(160,0,20)
        or Color3.fromRGB(28,28,33)

    Sword.BackgroundColor3 = Config.Sword
        and Color3.fromRGB(160,0,20)
        or Color3.fromRGB(28,28,33)
end

Connect(TP.Activated, function()
    Config.Teleport = not Config.Teleport
    Target = nil
    NextSearch = 0
    Refresh()
end)

Connect(Sword.Activated, function()
    Config.Sword = not Config.Sword
    Refresh()
end)

Connect(Input.InputBegan, function(key, processed)
    if processed or Input:GetFocusedTextBox() then return end

    if key.KeyCode == Enum.KeyCode.G then
        Frame.Visible = not Frame.Visible
    end
end)

Connect(Run.Heartbeat, function()
    local root = Root()
    if not root then return end

    local now = os.clock()

    if Config.Teleport then

        if not Valid(Target) then
            Target = nil

            if now >= NextSearch then
                NextSearch = now + 0.5
                Target = Nearest(Config.Radius)
            end
        end

        if Valid(Target) then
            local part = TargetPart(Target)

            root.CFrame = CFrame.new(
                part.Position + Vector3.new(0,Config.Height,0)
            ) * root.CFrame.Rotation

            root.AssemblyLinearVelocity = Vector3.zero

            Status.Text = "ALVO: " .. Target.Name
        else
            Status.Text = "PROCURANDO NOVO ALVO..."
        end

    else
        Target = nil
        Status.Text = Config.Sword
            and "AUTO SWORD ATIVO"
            or "SISTEMA EM ESPERA"
    end

    if Config.Sword and now >= NextAttack then
        NextAttack = now + Config.Interval

        local character = Player.Character
        local tool = character
            and character:FindFirstChildOfClass("Tool")

        local enemy = Target or Nearest(Config.SwordRadius)

        if tool and Valid(enemy) then
            local distance = (
                TargetPart(enemy).Position - root.Position
            ).Magnitude

            if distance <= Config.SwordRadius then
                tool:Activate()
            end
        end
    end
end)

Gui.Destroying:Connect(function()
    for _, c in ipairs(Connections) do
        c:Disconnect()
    end
end)

Refresh()
