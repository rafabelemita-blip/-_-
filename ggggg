-- ANIMACAO

local Animation
local AnimationID = 0

local function Fit()
    local camera = workspace.CurrentCamera

    if not camera then return 1 end

    return math.min(
        1,
        camera.ViewportSize.X/1020,
        camera.ViewportSize.Y/620
    )
end

local function Animate(open)
    AnimationID += 1
    local id = AnimationID

    if Animation then
        Animation:Cancel()
    end

    if open then
        Main.Visible = true
        Render()
    end

    Animation = Tween:Create(
        Scale,
        TweenInfo.new(
            0.28,
            Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {Scale = open and Fit() or Fit()*0.82}
    )

    Animation:Play()

    if not open then
        task.delay(0.28,function()
            if Running and id == AnimationID then
                Main.Visible = false
            end
        end)
    end
end

Connect(Input.InputBegan,function(key,processed)
    LastInput = os.clock()

    if processed or Input:GetFocusedTextBox() then
        return
    end

    if key.KeyCode == Enum.KeyCode.G then
        Visible = not Visible
        Animate(Visible)
    end
end)

-- ATUALIZACAO LEVE

local NextScan = 0
local NextMove = 0
local NextAttack = 0
local NextStats = 0

Connect(Run.RenderStepped,function(dt)
    FPS = FPS*0.95
        + (1/math.max(dt,0.001))*0.05
end)

Connect(Run.Heartbeat,function()
    if not Running then return end

    local now = os.clock()
    local root = Root()

    if not root then return end

    if now >= NextScan then
        NextScan = now + Config.ScanInterval
        Scan()
        Render()
    end

    if not Valid(Target) then
        Target = nil
    end

    if Target and now >= NextMove then
        NextMove = now + 0.05

        local p = Part(Target.Object)
        local h = Height(Target.Kind)

        if Priority(Target) < math.huge then
            root.CFrame = CFrame.new(
                p.Position + Vector3.new(0,h,0)
            ) * root.CFrame.Rotation

            root.AssemblyLinearVelocity = Vector3.zero

            Status.Text = Target.Kind.." | "..Target.Name

            if Config.Sword
                and Target.Kind ~= "GEMA"
                and now >= NextAttack then

                NextAttack = now + Config.AttackInterval

                local char = Player.Character
                local tool = char
                    and char:FindFirstChildOfClass("Tool")

                if tool then
                    tool:Activate()
                end
            end
        else
            Target = nil
        end
    end

    if not Target then
        Status.Text = "Procurando alvo..."
    end

    if now >= NextStats then
        NextStats = now + 1

        Performance.Text = math.floor(FPS)

        local seconds = math.floor(now-Started)
        local idle = math.floor(now-LastInput)

        Session.Text = string.format(
            "Sessao: %02d:%02d",
            math.floor(seconds/60),
            seconds%60
        )

        Idle.Text = "AFK: "..idle.."s"

        if Page == "AFK" then
            InfoBody.Text =
                "FPS: "..math.floor(FPS)
                .."\n\nSessao: "..seconds.." segundos"
                .."\n\nInatividade: "..idle.." segundos"
                .."\n\nBosses detectados: "..BossTotal
                .."\n\nEntidades: "..Total
                .."\n\nEspecies: "..#Groups
        end
    end
end)

