-- MONITOR DE ENTIDADES

local function Root()
    local char = Player.Character
    return char and char:FindFirstChild(
        "HumanoidRootPart"
    )
end

local function Part(obj)
    if obj:IsA("BasePart") then
        return obj
    end

    if obj:IsA("Model") then
        return obj:FindFirstChild("HumanoidRootPart")
            or obj.PrimaryPart
            or obj:FindFirstChildWhichIsA("BasePart",true)
    end
end

local function Has(name,word)
    return string.find(
        name:lower(),word,1,true
    ) ~= nil
end

local function Classify(obj)
    if obj:IsA("Model") then
        if Players:GetPlayerFromCharacter(obj) then
            return nil
        end

        local h = obj:FindFirstChildOfClass("Humanoid")

        if h and h.Health <= 0 then
            return nil
        end

        if h or Tags:HasTag(obj,"Animal")
            or Tags:HasTag(obj,"Boss")
            or Tags:HasTag(obj,"NPC") then

            if Has(obj.Name,"boss")
                or Tags:HasTag(obj,"Boss") then
                return "BOSS"
            end

            if Has(obj.Name,"alpha")
                or Has(obj.Name,"alfa")
                or Tags:HasTag(obj,"Alpha") then
                return "ALFA"
            end

            return "NPC"
        end
    end

    if Tags:HasTag(obj,"Gem")
        or Has(obj.Name,"gem")
        or Has(obj.Name,"crystal") then
        return "GEMA"
    end
end

local function Height(kind)
    if kind == "BOSS" then return Config.BossH end
    if kind == "ALFA" then return Config.AlphaH end
    if kind == "GEMA" then return 3 end
    return Config.NPCH
end

local function Valid(entry)
    if not entry or not entry.Object then return false end
    if not entry.Object:IsDescendantOf(workspace) then
        return false
    end

    local h = entry.Object:FindFirstChildOfClass("Humanoid")

    return Part(entry.Object) ~= nil
        and (not h or h.Health > 0)
end

local function Scan()
    local root = Root()
    if not root then return end

    local found = {}
    local bosses = 0

    for _,obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("Model") or obj:IsA("BasePart") then
            local kind = Classify(obj)

            if kind then
                local p = Part(obj)

                if p then
                    local distance = (
                        p.Position-root.Position
                    ).Magnitude

                    if distance <= Config.Radius then
                        table.insert(found,{
                            Object = obj,
                            Name = obj.Name,
                            Kind = kind,
                            Distance = distance
                        })

                        if kind == "BOSS" then
                            bosses += 1
                        end
                    end
                end
            end
        end
    end

    table.sort(found,function(a,b)
        return a.Distance < b.Distance
    end)

    Results = found

    MobCount.Text = tostring(#found)
    BossCount.Text = tostring(bosses)
end

local function Priority(entry)
    if entry.Kind == "BOSS" and Config.Boss then
        return 1
    end

    if entry.Kind == "ALFA" and Config.NPC then
        return 2
    end

    if entry.Kind == "NPC" and Config.NPC then
        return 3
    end

    if entry.Kind == "GEMA" and Config.Gems then
        return 4
    end

    return math.huge
end

local function SelectTarget()
    local best
    local priority = math.huge

    for _,entry in ipairs(Results) do
        local p = Priority(entry)

        if Valid(entry) and p < priority then
            best = entry
            priority = p
        end
    end

    return best
end

-- LISTA DE ENTIDADES

local function UpdateRadar()
    for _,obj in ipairs(List:GetChildren()) do
        if obj:IsA("Frame") then
            obj:Destroy()
        end
    end

    local index = 0

    for _,entry in ipairs(Results) do
        local show =
            CurrentPage == "Dashboard"
            or CurrentPage == "Radar"
            or (CurrentPage == "Bosses"
                and entry.Kind == "BOSS")
            or (CurrentPage == "Animais"
                and (entry.Kind == "NPC"
                or entry.Kind == "ALFA"))
            or (CurrentPage == "Gemas"
                and entry.Kind == "GEMA")

        if show then
            index += 1

            if index > 60 then break end

            local row = New("Frame",List,{
                Size = UDim2.new(1,-5,0,35),
                BackgroundColor3 = C.BG,
                LayoutOrder = index
            })

            Round(row,6)

            local color = entry.Kind == "BOSS"
                and C.Red
                or entry.Kind == "GEMA"
                and C.Green
                or C.Purple

            Text(row,entry.Name,8,0,220,35,12)

            Text(row,entry.Kind,230,0,90,35,11,color)

            Text(row,
                math.floor(entry.Distance).." ST",
                340,0,95,35,12,C.Gray
            )

            Text(row,
                Height(entry.Kind).." ST",
                450,0,70,35,12,color
            )
        end
    end
end

-- ATUALIZACAO DO SISTEMA

local NextScan = 0
local NextAttack = 0
local NextStats = 0

Connect(Run.RenderStepped,function(dt)
    FPS = FPS*0.9
        + (1/math.max(dt,0.001))*0.1
end)

Connect(Run.Heartbeat,function()
    if not Running then return end

    local now = os.clock()
    local root = Root()

    if not root then return end

    if now >= NextScan then
        NextScan = now + 1.5

        Scan()

        if Visible then
            UpdateRadar()
        end

        Target = SelectTarget()
    end

    if not Valid(Target) then
        Target = SelectTarget()
    end

    if Valid(Target) then
        local p = Part(Target.Object)
        local h = Height(Target.Kind)

        root.CFrame = CFrame.new(
            p.Position + Vector3.new(0,h,0)
        ) * root.CFrame.Rotation

        root.AssemblyLinearVelocity = Vector3.zero

        Status.Text = Target.Kind.." | "..Target.Name

        if Config.Sword
            and Target.Kind ~= "GEMA"
            and now >= NextAttack then

            NextAttack = now + 0.25

            local tool = Player.Character
                and Player.Character:FindFirstChildOfClass("Tool")

            if tool then
                tool:Activate()
            end
        end
    else
        Status.Text = "SYSTEM READY"
    end

    if now >= NextStats then
        NextStats = now + 1

        FPSLabel.Text = math.floor(FPS).." FPS"

        local elapsed = math.floor(now-StartTime)

        Clock.Text = string.format(
            "Sessao: %02d:%02d",
            math.floor(elapsed/60),
            elapsed%60
        )

        Ping.Text = "Ping: "..
            math.floor(Player:GetNetworkPing()*1000).." ms"

        Idle.Text = Config.AFK
            and "AFK: "..math.floor(IdleTime).."s"
            or "AFK: OFF"

        Idle.TextColor3 = IdleTime >= 900
            and C.Red or C.Green
    end
end)

