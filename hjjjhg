-- ANIMACAO E TECLA G

local Animation
local AnimationID = 0

local function Animate()
    AnimationID += 1
    local id = AnimationID

    if Animation then
        Animation:Cancel()
    end

    if Visible then
        Main.Visible = true
    end

    local camera = workspace.CurrentCamera

    local fit = camera and math.min(
        1,
        camera.ViewportSize.X/1000,
        camera.ViewportSize.Y/630
    ) or 1

    Animation = Tween:Create(
        Scale,
        TweenInfo.new(
            0.25,Enum.EasingStyle.Quart,
            Enum.EasingDirection.Out
        ),
        {Scale = Visible and fit or fit*0.8}
    )

    Animation:Play()

    if not Visible then
        task.delay(0.25,function()
            if id == AnimationID then
                Main.Visible = false
            end
        end)
    end
end

Input.InputBegan:Connect(function(key,processed)
    LastInput = os.clock()

    if processed or Input:GetFocusedTextBox() then
        return
    end

    if key.KeyCode == Enum.KeyCode.G then
        Visible = not Visible
        Animate()

    elseif key.KeyCode == Enum.KeyCode.F then
        Remote:FireServer("ManualF")
    end
end)

