        if page=='Dashboard' then info.Text='ENTIDADES '..#entries..'  |  ESPECIES '..#groups..'  |  F '..fCount..'  |  CLIQUES '..clickCount
        elseif page=='Dungeons' then info.Text=portal and 'Portal detectado' or 'Portal nao detectado / boss ativo'
