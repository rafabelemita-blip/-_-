-- PORTAIS
local function PortalPart(obj)
    if not obj:IsDescendantOf(workspace) then return end
    if obj:IsA("TextLabel") then
        if not IsPortal(obj.Text) then return end
        local parent=obj.Parent
        while parent and parent~=workspace do
            if parent:IsA("BillboardGui") or parent:IsA("SurfaceGui") then
                local adornee=parent.Adornee
                if adornee and adornee:IsA("Attachment") then adornee=adornee.Parent end
                local part=Part(adornee)
                if part then return part end
            end
            local p=Part(parent)
            if p then return p end
            parent=parent.Parent
        end
    elseif IsPortal(obj.Name) then return Part(obj) end
end
local function Valid(entry)
    if not entry or not entry.Object or not entry.Object:IsDescendantOf(workspace) then return false end
    local h=entry.Object:FindFirstChildOfClass("Humanoid")
    return Part(entry.Object)~=nil and (not h or h.Health>0)
end
local function Height(kind)
    if kind=="BOSS" then return 50 end
    if kind=="ALFA" then return 30 end
    if kind=="GEMA" then return 3 end
    return 20
end
local function Priority(entry)
    if Config.SelectedOnly and not Selected[entry.Key] then return math.huge end
    if entry.Kind=="BOSS" and (Config.Boss or Config.All) then return 1 end
    if entry.Kind=="ALFA" and (Config.NPC or Config.All) then return 2 end
    if entry.Kind=="NPC" and (Config.NPC or Config.All) then return 3 end
    if entry.Kind=="GEMA" and Config.Gems then return 4 end
    return math.huge
end
-- SCANNER AGRUPADO
local function Scan()
    local root=Root()
    NearbyEnemy=false
    if not root then Target=nil; PortalTarget=nil; return end
    local grouped={}
    local best,bestPriority=nil,math.huge
    local portal,portalDistance=nil,Config.Radius
    local bossAlive=false
    for obj in pairs(Cache) do
        if not obj:IsDescendantOf(workspace) then Cache[obj]=nil
        else
            local pp=PortalPart(obj)
            if pp then
                local distance=(pp.Position-root.Position).Magnitude
                if distance<=portalDistance then portal=pp; portalDistance=distance end
            elseif not obj:IsA("TextLabel") then
                local kind=Classify(obj)
                local part=kind and Part(obj)
                if part then
                    local distance=(part.Position-root.Position).Magnitude
                    local name=Name(obj)
                    local key=Key(name)
                    if kind~="GEMA" and distance<=Config.AuraRadius and (not Config.SelectedOnly or Selected[key]) then NearbyEnemy=true end
                    if distance<=Config.Radius then
                        if kind=="BOSS" then bossAlive=true end
                        local g=grouped[key]
                        if not g then
                            grouped[key]={Name=name,Key=key,Kind=kind,Count=1,Distance=distance}
                        else
                            g.Count=g.Count+1
                            if distance<g.Distance then g.Distance=distance; g.Kind=kind end
                        end
                        local entry={Object=obj,Key=key,Name=name,Kind=kind,Distance=distance}
                        local p=Priority(entry)
                        if p<math.huge and (not best or p<bestPriority or (p==bestPriority and distance<best.Distance)) then
                            best=entry; bestPriority=p
                        end
                    end
                end
            end
        end
    end
    Groups={}
    for _,g in pairs(grouped) do table.insert(Groups,g) end
    table.sort(Groups,function(a,b) return a.Distance<b.Distance end)
    Target=best
    PortalTarget=Config.Portal and not bossAlive and portal or nil
end
