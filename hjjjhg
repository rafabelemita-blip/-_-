local function Render()
    for key,control in pairs(Controls) do
        control.Button.Text = control.Label..
            (Data[key] and " [ON]" or " [OFF]")

        control.Button.BackgroundColor3 =
            Data[key] and C.Blue or C.BG
    end

    Stats.Text =
        "KILLS: "..(Data.Kills or 0)
        .."   |   GEMAS: "..(Data.GemCount or 0)
