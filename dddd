local function PhysicsStep(root,active)
    local hum=Humanoid()
    if not hum or not root then return end
    for old in pairs(CharacterOriginal) do if old~=hum then CharacterOriginal[old]=nil end end
    for part in pairs(CollisionOriginal) do if not part:IsDescendantOf(Player.Character) then CollisionOriginal[part]=nil end end
    if Config.SpeedOn or Config.JumpOn then
        if not CharacterOriginal[hum] then CharacterOriginal[hum]={Speed=hum.WalkSpeed,UseJumpPower=hum.UseJumpPower,Jump=hum.JumpPower,JumpHeight=hum.JumpHeight} end
        local saved=CharacterOriginal[hum]
        local wanted=Config.SpeedOn and Config.Speed or saved.Speed
        if hum.WalkSpeed~=wanted then hum.WalkSpeed=wanted end
        if Config.JumpOn then hum.UseJumpPower=true; hum.JumpPower=Config.Jump
        else hum.UseJumpPower=saved.UseJumpPower; hum.JumpPower=saved.Jump; hum.JumpHeight=saved.JumpHeight end
    else
        for h,v in pairs(CharacterOriginal) do if h.Parent then h.WalkSpeed=v.Speed; h.UseJumpPower=v.UseJumpPower; h.JumpPower=v.Jump; h.JumpHeight=v.JumpHeight end end
        table.clear(CharacterOriginal)
    end
    if Config.Noclip and Player.Character then
        for _,p in ipairs(Player.Character:GetDescendants()) do if p:IsA("BasePart") then if CollisionOriginal[p]==nil then CollisionOriginal[p]=p.CanCollide end; p.CanCollide=false end end
    else
        for p,value in pairs(CollisionOriginal) do if p.Parent then p.CanCollide=value end end; table.clear(CollisionOriginal)
    end
    if Config.Flight and not active then
        local y=FlightY
        if not Input:GetFocusedTextBox() then
            if Input:IsKeyDown(Enum.KeyCode.Space) then y=1 elseif Input:IsKeyDown(Enum.KeyCode.LeftControl) then y=-1 end
        end
        local move=hum.MoveDirection
        root.AssemblyLinearVelocity=Vector3.new(move.X,y,move.Z)*Config.FlightSpeed
    end
end
